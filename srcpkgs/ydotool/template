# Template file for 'ydotool'
pkgname=ydotool
version=1.0.4
revision=1

build_style=cmake
hostmakedepends="cmake"

# Disable systemd user service; OpenRC service file is not built by default
configure_args="-DSYSTEMD_USER_SERVICE=OFF -DSYSTEMD_SYSTEM_SERVICE=OFF -DBUILD_DOCS=OFF"

short_desc="Generic command-line automation tool for Linux (no X required)"
maintainer="Viking Maker <vikingmaker@outlook.com>"
license="AGPL-3.0-or-later"

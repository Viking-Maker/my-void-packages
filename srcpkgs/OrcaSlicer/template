# Template file for 'OrcaSlicer'
pkgname=OrcaSlicer
version=2.4.2
revision=1
build_style=cmake
build_helper="cmake-wxWidgets-gtk3"
configure_args="-DOPENVDB_FIND_MODULE_PATH=/usr/lib/cmake/OpenVDB"
configure_args+=" -DCMAKE_CXX_STANDARD=17"

# Safely append C++ compiler flags globally to avoid nested quote parsing issues
# Disabled dangling-reference, maybe-uninitialized, and range-loop-construct false positives on GCC 14
# Added /usr/include/opencv4 to globally resolve private target dependency visibility bugs
CXXFLAGS+=" -fpermissive -Wno-dangling-reference -Wno-error=dangling-reference"
CXXFLAGS+=" -Wno-maybe-uninitialized -Wno-error=maybe-uninitialized"
CXXFLAGS+=" -Wno-range-loop-construct -Wno-error=range-loop-construct"
CXXFLAGS+=" -I/usr/include/opencv4"

# Force linker to include libX11, libwebkit2gtk-4.1, and libblosc despite --as-needed sorting optimizations
LDFLAGS+=" -Wl,--no-as-needed -lX11 -lwebkit2gtk-4.1 -lblosc -Wl,--as-needed"

hostmakedepends="autoconf automake cmake extra-cmake-modules gettext git pkg-config libtool ninja texinfo tar xz"

# gmpxx-devel and c-blosc-devel added here to provide required math bindings
makedepends="glew-devel gtk+3-devel libmspack-devel libsecret-devel libspnav-devel openssl-devel
 eudev-libudev-devel libwebkit2gtk41-devel boost-devel tbb-devel libcurl-devel glfw-devel
 nlopt-devel openvdb-devel gmp-devel gmpxx-devel mpfr-devel libopencv-devel occt-devel libnoise-devel draco-devel
 dbus-devel wxWidgets-gtk3-devel gstreamer1-devel gst-plugins-base1-devel MesaLib-devel
 glu-devel gtest-devel cereal eigen protobuf-devel c-blosc-devel"

depends="file wget"
short_desc="G-code generator for 3D printers"
maintainer="Viking Maker <vikingmaker@outlook.com>"
license="AGPL-3.0-only"
homepage="https://www.orcaslicer.com/"
distfiles="https://github.com/OrcaSlicer/OrcaSlicer/archive/refs/tags/v${version}.tar.gz
 https://github.com/CGAL/cgal/releases/download/v5.6.1/CGAL-5.6.1.tar.xz"

checksum="d97244baf15eb9377aa86714cb042d537ff3b1db13b7c2657cf865b820701cf0
 cdb15e7ee31e0663589d3107a79988a37b7b1719df3d24f2058545d1bcdd5837"

skip_extraction="CGAL-5.6.1.tar.xz"

post_extract() {
	# Manually extract CGAL to bypass xbps-src multi-distfile limitations
	tar xf ${XBPS_SRCDISTDIR}/${pkgname}-${version}/CGAL-5.6.1.tar.xz -C ${wrksrc}/..

	# Remove obsolete 'system' component of Boost from main configuration
	vsed -i 's/system filesystem thread/filesystem thread/g' CMakeLists.txt

	# Remove obsolete 'system' component of Boost from OpenVDB module
	vsed -i 's/iostreams system/iostreams/g' cmake/modules/FindOpenVDB.cmake

	# Proactively fix missing header in Bonjour utility for modern Boost compatibility
	vsed -i '1i#include <boost/asio/deadline_timer.hpp>' src/slic3r/Utils/Bonjour.hpp

	# Fix GCC 14 strictness by safely blanking out ONLY the specific vector reserve call
	# that triggers noexcept static assert failures, without breaking other multi-line equations.
	vsed -i 's/result\.reserve(models\.size());//g' src/libslic3r/CutSurface.cpp

	# Fix libnoise include path to match Linux system installations
	vsed -i 's/libnoise\/noise\.h/noise\/noise\.h/g' src/libslic3r/Feature/FuzzySkin/FuzzySkin.cpp

	# Fix CGAL 5.6+ compatibility in MeshBoolean.cpp (non-const lvalue reference binding to rvalue proxies)
	vsed -i 's/for (auto &vi :/for (auto vi :/g' src/libslic3r/MeshBoolean.cpp
	vsed -i 's/for (auto &face :/for (auto face :/g' src/libslic3r/MeshBoolean.cpp

	# Force CMake to accept the system's 3.4.0 version of Eigen3 instead of demanding 5.0.1
	vsed -i 's/5.0.1/3.4.0/g' CMakeLists.txt

	# Downgrade strict wxWidgets version requirement from 3.3 to stable 3.2
	vsed -i 's/find_package(wxWidgets 3.3/find_package(wxWidgets 3.2/g' src/CMakeLists.txt

	# Globally replace deprecated boost::asio::io_service with modern boost::asio::io_context
	# (Required for modern Boost 1.87+ which completely removed the io_service legacy typedef)
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/io_service/io_context/g' {} +

	# Globally replace deprecated boost::process (v1) usages with legacy namespace redirects
	# (Required for modern Boost 1.87+ where boost::process.hpp now loads v2 by default)
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/<boost\/process\.hpp>/<boost\/process\/v1.hpp>/g' {} +
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/boost::process::/boost::process::v1::/g' {} +
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/namespace process = boost::process;/namespace process = boost::process::v1;/g' {} +

	# Globally convert legacy io_context.post(...) member functions to modern boost::asio::post(*io_context, ...)
	# (Required for modern Boost 1.87+ which completely removed the context.post() member function)
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/io_context->post(/boost::asio::post(*io_context, /g' {} +
	find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) -exec sed -i 's/io_context\.post(/boost::asio::post(io_context, /g' {} +

	# Fix Boost 1.87+ compatibility in TCPConsole.cpp (results_type no longer publicly inherits iterator)
	vsed -i 's/endpoints->/endpoints.begin()->/g' src/slic3r/Utils/TCPConsole.cpp

	# Fix OpenCV and OpenCASCADE (OCCT) linking issues on modern Linux systems:
	# 1. OpenCV: Use ${OpenCV_LIBS} instead of non-existent opencv_world on Linux, and add imgproc & imgcodecs dependencies
	vsed -i 's/find_package(OpenCV REQUIRED core)/find_package(OpenCV REQUIRED core imgproc imgcodecs)/g' src/libslic3r/CMakeLists.txt
	vsed -i 's/opencv_world/${OpenCV_LIBS}/g' src/libslic3r/CMakeLists.txt

	# 2. OCCT: Replace consolidated legacy STEP libraries with modern TKDESTEP
	vsed -i '/TKSTEP/d' src/libslic3r/CMakeLists.txt
	vsed -i '/TKSTEP209/d' src/libslic3r/CMakeLists.txt
	vsed -i '/TKSTEPAttr/d' src/libslic3r/CMakeLists.txt
	vsed -i '/TKSTEPBase/d' src/libslic3r/CMakeLists.txt
	vsed -i 's/TKXDESTEP/TKDESTEP/g' src/libslic3r/CMakeLists.txt

	# Overwrite Findlibnoise.cmake to force correct paths and define the 'noise::noise' target.
	cat <<'EOF' > cmake/modules/Findlibnoise.cmake
set(LIBNOISE_INCLUDE_DIR "/usr/include")
set(LIBNOISE_LIBRARY "/usr/lib/libnoise.so")
set(libnoise_FOUND TRUE)
set(LIBNOISE_FOUND TRUE)

if(NOT TARGET noise::noise)
  add_library(noise::noise UNKNOWN IMPORTED)
  set_target_properties(noise::noise PROPERTIES
    IMPORTED_LOCATION "${LIBNOISE_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${LIBNOISE_INCLUDE_DIR}"
  )
endif()
EOF
}

pre_configure() {
	msg_normal "Configuring local CGAL 5.6.1 to bypass Void's outdated system version...\n"
	cd ${wrksrc}/../CGAL-5.6.1

	# Fix upstream CGAL 5.6.1 issue missing boost include (fails SFINAE for is_zero)
	vsed -i '1i#include <boost/mpl/if.hpp>' include/CGAL/number_utils.h

	cmake -B build -DCMAKE_INSTALL_PREFIX="${wrksrc}/cgal-local"
	cmake --install build

	cd ${wrksrc}

	# Add the local CGAL directory to CMake's search path.
	configure_args+=" -DCMAKE_PREFIX_PATH=${wrksrc}/cgal-local"

	# Force CGAL's include path into CXXFLAGS so targets that privately link it (like libslic3r) can still find it
	export CXXFLAGS="${CXXFLAGS} -I${wrksrc}/cgal-local/include"
}

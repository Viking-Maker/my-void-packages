# Template file for 'helium-browser-bin'
pkgname=helium-browser-bin
version=0.18.3.1
revision=1
archs="x86_64 aarch64"
short_desc="Private, fast, and honest web browser based on Chromium (binary build)"
maintainer="Viking Maker <vikingmaker@outlook.com>"
license="GPL-3.0-only, BSD-3-Clause"
homepage="https://github.com/imputnet/helium-linux"

# Map Void archs to Helium release naming
case "$XBPS_TARGET_MACHINE" in
	x86_64) _helium_arch="x86_64" ;;
	aarch64) _helium_arch="arm64" ;;
esac

distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-${_helium_arch}_linux.tar.xz
 https://raw.githubusercontent.com/imputnet/helium-linux/${version}/LICENSE.ungoogled_chromium"
# The license is a plain text file; fetch it without attempting extraction.
skip_extraction="LICENSE.ungoogled_chromium"

case "$XBPS_TARGET_MACHINE" in
	x86_64) checksum="89bd962ca5e5159916a4c4befa5a9a08f540d2d8cd794f2f955e8d5d4a463bf2
 9539b394e4179952698894bd62ef6566b6804ab0ff360dcf3a511cfaf7f78c4d" ;;
	aarch64) checksum="4b7b744e55c40272fb34b148aead7e36b8d8d08d044131f4572f4fa95d14ec92
 9539b394e4179952698894bd62ef6566b6804ab0ff360dcf3a511cfaf7f78c4d" ;;
esac

do_install() {
	vmkdir usr/lib/helium-browser
	cp -r "${srcdir}/builddir/helium-browser-bin-${version}"/* "${DESTDIR}/usr/lib/helium-browser/"
	vmkdir usr/bin
	ln -sf /usr/lib/helium-browser/helium "${DESTDIR}/usr/bin/helium-browser"
	vinstall "${FILESDIR}/helium-browser.desktop" 644 usr/share/applications

	# BSD-3-Clause license text for the bundled ungoogled-chromium code.
	# Not shipped inside the binary tarball, so install it from the fetched
	# distfile (see skip_extraction above).
	vlicense "${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE.ungoogled_chromium"
}

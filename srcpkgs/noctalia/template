build_style=meson
hostmakedepends="pkg-config"
makedepends="basu-devel cairo-devel fontconfig-devel freetype-devel harfbuzz-devel
	jemalloc-devel json-c++ libcurl-devel libepoxy-devel libglvnd-devel libmd4c-devel
	libqalculate-devel librsvg-devel libsodium-devel libwebp-devel libxkbcommon-devel
	libxml2-devel libsecret-devel libjxl-devel MesaLib-devel pam-devel pango-devel
	libsndfile-devel pipewire-devel polkit-devel sdbus-c++-devel stb tomlplusplus-devel
	libical-devel wayland-devel wayland-protocols wireplumber-devel"

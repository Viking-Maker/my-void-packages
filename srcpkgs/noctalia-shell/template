# Template file for 'noctalia-shell'
pkgname=noctalia-shell
version=5.2.1
revision=1
depends="noctalia-qs python3 python3-Pillow brightnessctl ImageMagick git"
short_desc="Sleek and minimal desktop shell for Wayland"
maintainer="Viking Maker <vikingmaker@outlook.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/noctalia-dev/noctalia-shell"
distfiles="$homepage/archive/v${version}.tar.gz"
checksum=5418f6b759de96e56a4bbca809c5a4c60a8a9594bdf67ecb8c5a341f97c221d1

do_install() {
	# This creates the folder where the shell lives
	vmkdir usr/share/noctalia

	# This copies the QML and assets into that folder
	vcopy "*" usr/share/noctalia

	# This creates a small script in /usr/bin to launch the shell
	vmkdir usr/bin
	printf "#!/bin/sh\nexec qs /usr/share/noctalia/main.qml\n" > ${DESTDIR}/usr/bin/noctalia
	chmod 755 ${DESTDIR}/usr/bin/noctalia
}

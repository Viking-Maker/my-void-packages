# Template file for 'antigravity-cli'
# Pre-built x86_64 (glibc, dynamically linked) binary of Google's Antigravity CLI
# from the official GitHub release. Upstream ships the binary only (no source
# archive and no LICENSE file in the repo); use of the agent is governed by
# Google's Terms of Service (https://antigravity.google/terms), which is
# committed in files/ because that page is a UA-dependent/JS-rendered page
# with no stable checksum (it is fetched differently by every user agent).
pkgname=antigravity-cli
version=1.2.17
revision=1
archs="x86_64"
build_style=fetch
depends="git"
short_desc="Google Antigravity CLI agent (pre-built binary)"
maintainer="Viking Maker <vikingmaker@outlook.com>"
license="custom:ToS"
homepage="https://github.com/google-antigravity/antigravity-cli"
changelog="https://github.com/google-antigravity/antigravity-cli/releases"

distfiles="https://github.com/google-antigravity/antigravity-cli/releases/download/${version}/agy_cli_linux_x64.tar.gz"
checksum=b0ed8a7c375b5af3af973f08a601e41aebb38bac7e80b922ab54d973a4275493

# Dynamic glibc binary; already stripped.
nostrip=yes
nopie=yes

post_extract() {
	bsdtar xf agy_cli_linux_x64.tar.gz
	# No license ships with the binary; copy in the committed ToS snapshot so
	# vlicense can install it to /usr/share/licenses/antigravity-cli.
	cp "${XBPS_DISTDIR}/srcpkgs/${pkgname}/files/terms" terms
}

do_install() {
	vbin antigravity
	vlicense terms
}
